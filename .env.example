# ─────────────────────────────────────────────
# E-Forecast — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in values:
#   cp .env.example .env
# ─────────────────────────────────────────────

# App
APP_TITLE=E-Forecast
APP_DEBUG=false

# Cache
CACHE_TTL_SECONDS=3600

# Rate Limiter (Yahoo Finance)
YAHOO_RATE_MIN_INTERVAL=2.0
YAHOO_MAX_RETRIES=5

# Ingestion
INGESTION_INTERVAL=600

# Model defaults
MODEL_CHANGEPOINT_PRIOR_SCALE=0.05
MODEL_SEASONALITY_PRIOR_SCALE=10.0
MODEL_SEASONALITY_MODE=multiplicative
MODEL_USE_REGRESSORS=true

# Optuna tuning
OPTUNA_N_TRIALS=30

# Backtest
MAPE_THRESHOLD=15.0

# Server (gateway) — host the Streamlit app uses to reach the gateway.
# Use "localhost" for local/non-Docker runs; docker compose overrides this
# to the "gateway" service name for the app container (see compose.yaml).
GATEWAY_HOST=localhost
GATEWAY_PORT=8000
# Comma-separated allowed CORS origins ("*" = any)
CORS_ORIGINS=*

# Database — PostgreSQL in Docker; for local dev without Docker use SQLite:
#   DATABASE_URL=sqlite+aiosqlite:///./forecast.db
DATABASE_URL=postgresql+asyncpg://forecast:forecast@db:5432/forecast

# NewsAPI (optional — get free key at https://newsapi.org/register)
NEWSAPI_API_KEY=

# Auth — generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty/placeholder, the gateway uses a random per-process secret
# (logins are then invalidated on every restart).
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
AUTH_REQUIRE_VERIFICATION=true
PASSWORD_MIN_LENGTH=8
# Brute-force protection: failed logins per identifier before lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Resend (email) — required for password reset and email verification
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=E-Forecast

# App base URL (used in email links)
APP_BASE_URL=http://localhost:8501

# Logging
LOG_LEVEL=INFO
